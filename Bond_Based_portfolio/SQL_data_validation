with ranked as(
 SELECT 
        p.*,
        ROW_NUMBER() OVER (
            PARTITION BY p.isin
            ORDER BY p.dirty_price DESC
        ) AS rn
    FROM prices_5000 p
    JOIN security_master_5000 s
      ON p.isin = s.isin
    WHERE
        p.dirty_price >= p.clean_price
        AND p.currency = s.currency
)
delete P 
FROM prices_5000 p
LEFT JOIN ranked r
  ON p.isin = r.isin
 AND p.price_date = r.price_date
 and p.clean_price = r.clean_price
 AND p.dirty_price =r.dirty_price 
 AND p.currency=r.currency
 AND p.price_source = r.price_source
JOIN  security_master_5000 s
  ON p.isin = s.isin
WHERE
      p.dirty_price < p.clean_price
   OR p.currency <> s.currency
   OR r.rn > 1;


