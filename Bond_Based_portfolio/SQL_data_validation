--PORTFOLIO SUMMARY
create view portfolio_summary as
select portfolio_id,as_of_date,sum(market_value_usd) as total_market_value,
sum(book_value_usd) as total_book_value,
sum(unrealized_pnl) as total_pnl
from vw_portfolio_valuation
group by portfolio_id,as_of_date 

---PF3 is the largest portfolio and contributes the most to total firm exposure.
--It also carries the highest unrealized P&L, so risk and reward are concentrated here.
--Any market shock will impact PF3 first

---RISK MATRIC EXPOSURE_________

-----ISIN Concentration Risk---------
SELECT
    portfolio_id,
    isin,
    SUM(market_value_usd) AS isin_market_value,
    SUM(market_value_usd) 
      / SUM(SUM(market_value_usd)) OVER (PARTITION BY portfolio_id) * 100
      AS pct_of_portfolio
FROM vw_portfolio_valuation
GROUP BY portfolio_id, isin
ORDER BY pct_of_portfolio DESC
-- Portfolio may benefit from diversification across issuers 

----------Unrealized P&L Analysis-----------
create view vw_unrealized_PandL as
SELECT
    portfolio_id,
    isin,
    SUM(unrealized_pnl) AS total_unrealized_pnl
FROM vw_portfolio_valuation
GROUP BY portfolio_id, isin



SELECT
    portfolio_id,
    isin,
    SUM(unrealized_pnl) AS total_unrealized_pnl,
	sum(DATEDIFF(year,as_of_date,maturity_date)) as years_to_maturity
FROM vw_portfolio_valuation
GROUP BY portfolio_id, isin
having sum(DATEDIFF(year,as_of_date,maturity_date)) >4 and SUM(unrealized_pnl)<0 and SUM(unrealized_pnl)<-10000
ORDER BY total_unrealized_pnl ASC
----longdates bonds which are in loses(bonds at risks)


---------Interest Rate Sensitivity
create view vw_marturity_exposure as
SELECT
    portfolio_id,
    CASE 
        WHEN maturity_date <= DATEADD(YEAR,2, as_of_date) THEN 'SHORT'
        WHEN maturity_date <= DATEADD(YEAR, 7, as_of_date) THEN 'MEDIUM'
        ELSE 'LONG'
    END AS maturity_bucket,
    SUM(market_value_usd) AS exposure
FROM vw_portfolio_valuation
GROUP BY portfolio_id,
         CASE 
            WHEN maturity_date <= DATEADD(YEAR, 2, as_of_date) THEN 'SHORT'
            WHEN maturity_date <= DATEADD(YEAR, 7, as_of_date) THEN 'MEDIUM'
            ELSE 'LONG'
         END;
---Portfolio 1 have high volatality towards rate i.e, LONG category

