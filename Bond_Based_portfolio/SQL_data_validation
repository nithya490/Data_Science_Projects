drop view vw_portfolio_valuation
create view vw_portfolio_valuation As
select 
h.portfolio_id,h.as_of_date ,h.quantity ,h.isin,h.book_cost_per_bond,
s.issuer_name,s.currency as security_currency,s.maturity_date,p.yield,
s.par_value,p.clean_price,
h.quantity*(p.clean_price/100.0)*s.par_value as Market_value_local,
coalesce(f.usd_rate,1.0) as usd_rate,
h.quantity*(p.clean_price/100.0)*s.par_value*coalesce(f.usd_rate,1.0) as market_value_usd,
h.quantity*h.book_cost_per_bond as book_value ,
(h.quantity * h.book_cost_per_bond * COALESCE(f.usd_rate, 1.0)) AS book_value_usd,
(h.quantity*(p.clean_price/100.0)*s.par_value*coalesce(f.usd_rate,1.0))-(h.quantity * h.book_cost_per_bond * COALESCE(f.usd_rate, 1.0)) as unrealized_pnl
from holdings_5000 h join security_master_5000 s on h.isin=s.isin join prices_5000 p on h.isin=p.isin and p.price_date=h.as_of_date
join fx f on h.as_of_date=f.date and f.currency=s.currency

