--------Issuer Concentration----------
Create view Issuer_exposure as
SELECT
    portfolio_id,
    issuer_name,
    SUM(market_value_usd) AS exposure
FROM vw_portfolio_valuation
GROUP BY portfolio_id, issuer_name
--ORDER BY exposure DESC
---PF3 has significant EUR exposure, making it sensitive to EUR/USD movements.
--A depreciation of EUR will reduce USD portfolio value even if bond prices remain unchanged
SELECT
    portfolio_id,
    issuer_name,
    SUM(market_value_usd) AS issuer_value,
    SUM(market_value_usd) 
      / SUM(SUM(market_value_usd)) OVER (PARTITION BY portfolio_id) * 100
      AS issuer_pct
FROM vw_portfolio_valuation
GROUP BY portfolio_id, issuer_name
ORDER BY issuer_pct DESC

